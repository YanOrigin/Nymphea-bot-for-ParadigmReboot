# ===== NoneBot 基础配置（复制为 .env.prod 使用）=====
DRIVER=~fastapi
HOST=127.0.0.1
PORT=7999
LOG_LEVEL=INFO

# 命令前缀：支持 /cmd 和 cmd 两种写法
COMMAND_START=["/", ""]

# ===== OneBot V11（NapCat 反向 WebSocket 连这里）=====
# NapCat WebUI → 网络配置 → 反向 WebSocket:
#   URL:   ws://127.0.0.1:7999/onebot/v11/ws
ONEBOT_ACCESS_TOKEN=

# ===== 别名库 GitHub 自动同步（alias_sync 插件，不使用可删除）=====
ALIAS_SYNC_GITHUB_REPO=yourname/your-alias-repo
ALIAS_SYNC_GITHUB_TOKEN=github_pat_xxx
ALIAS_SYNC_GITHUB_PATH=aliases.json
ALIAS_SYNC_GITHUB_BRANCH=main
# 自动同步间隔（秒）；0 = 关闭
ALIAS_SYNC_INTERVAL=300

# ===== 曲库每日更新（song_refresh 插件）=====
# 每日刷新时刻（本地时间 HH:MM）；留空 = 关闭
SONG_REFRESH_TIME=04:00
# 启动时立即刷新一次（调试/首次引导用，平时关）
SONG_REFRESH_ON_START=false

# ===== 查分器（paradigm_score 插件）=====
# PRP 谱面映射静态表目录（ParadigmReboot-Tracker 私有库内容，见其 README）
PRP_TABLES_DIR=data/prp_tables
# 私有查分核心库路径（可选；默认自动探测 D:\Developed\ParadigmReboot-Tracker）
TRACKER_CORE_DIR=
